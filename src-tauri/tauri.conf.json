{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desktop",
  "version": "1.5.1",
  "identifier": "dev.dsh.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src http: https:; connect-src 'self' http: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/runtime": "runtime"
    },
    "icon": [
      "icons/deepseek.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/deepseek.ico",
        "uninstallerIcon": "icons/deepseek.ico",
        "installMode": "both",
        "startMenuFolder": "DeepSeek Harness Desktop",
        "compression": "lzma",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/luanshang/DeepSeek-Harness-Desktop-Built-with-Tauri/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENTY1MUMwMDRDQzBCQTMKUldTakM4d0V3RkZXamZxZFBRb1RLTGNvTU9teFBDR3J5aXI5KzlaeU8vRTBFM1h5Q1g2OUpNcmIK"
    }
  }
}
